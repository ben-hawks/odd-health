<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon foreground: a ring with a pulse line crossing it.
     108dp canvas; everything stays inside the 66dp safe zone (21..87). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:pathData="M54,28a26,26 0,1 1,0 52a26,26 0,1 1,0 -52z"
        android:strokeWidth="6"
        android:strokeColor="@color/ic_launcher_ring"
        android:fillColor="#00000000" />
    <!-- Background-coloured halo so the pulse cuts cleanly through the ring -->
    <path
        android:pathData="M22,55 L40,55 L46,40 L54,68 L61,47 L66,55 L86,55"
        android:strokeWidth="11"
        android:strokeColor="@color/ic_launcher_background"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M22,55 L40,55 L46,40 L54,68 L61,47 L66,55 L86,55"
        android:strokeWidth="5"
        android:strokeColor="@color/ic_launcher_pulse"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
